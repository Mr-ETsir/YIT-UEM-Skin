{% extends 'admin.base' %}

{% block title %}{{ trans('StudentVerification::student-verification.admin_codes_title') }}{% endblock %}

{% block content %}
<div class="row">
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-ticket-alt mr-1"></i>
          {{ trans('StudentVerification::student-verification.admin_codes_generate') }}
        </h3>
      </div>
      <div class="card-body">
        {% if session('success') %}
          <div class="alert alert-success py-2">{{ session('success') }}</div>
        {% endif %}
        <form method="post" action="{{ url('admin/student-verification/codes') }}">
          <input type="hidden" name="_token" value="{{ csrf_token() }}">
          <div class="form-group">
            <label>{{ trans('StudentVerification::student-verification.admin_codes_count') }}</label>
            <input type="number" class="form-control" name="count" min="1" max="100" value="1" required>
          </div>
          <div class="form-group">
            <label>{{ trans('StudentVerification::student-verification.admin_codes_remark') }}</label>
            <input type="text" class="form-control" name="remark" maxlength="255"
                   placeholder="{{ trans('StudentVerification::student-verification.admin_codes_remark_placeholder') }}">
            <small class="form-text text-muted">{{ trans('StudentVerification::student-verification.admin_codes_remark_hint') }}</small>
          </div>
          <div class="form-group">
            <label>{{ trans('StudentVerification::student-verification.admin_codes_expire') }}</label>
            <input type="number" class="form-control" name="expire_days" min="1" max="365" value="30"
                   placeholder="{{ trans('StudentVerification::student-verification.admin_codes_expire_placeholder') }}">
            <small class="form-text text-muted">{{ trans('StudentVerification::student-verification.admin_codes_expire_hint') }}</small>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-plus mr-1"></i>{{ trans('StudentVerification::student-verification.admin_codes_generate_btn') }}
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-list mr-1"></i>
          {{ trans('StudentVerification::student-verification.admin_codes_list') }}
        </h3>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
          <thead>
            <tr>
              <th>{{ trans('StudentVerification::student-verification.admin_codes_code') }}</th>
              <th>{{ trans('StudentVerification::student-verification.admin_codes_remark') }}</th>
              <th>{{ trans('StudentVerification::student-verification.admin_codes_status') }}</th>
              <th>{{ trans('StudentVerification::student-verification.admin_codes_user') }}</th>
              <th>{{ trans('StudentVerification::student-verification.admin_codes_used_at') }}</th>
              <th>{{ trans('StudentVerification::student-verification.admin_codes_expires') }}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for code in codes %}
              <tr>
                <td><code>{{ code.code }}</code></td>
                <td style="max-width:160px">{{ code.remark }}</td>
                <td>
                  {% if code.used_by %}
                    <span class="badge badge-secondary">{{ trans('StudentVerification::student-verification.admin_codes_used') }}</span>
                  {% elseif code.revoked %}
                    <span class="badge badge-danger">{{ trans('StudentVerification::student-verification.admin_codes_revoked') }}</span>
                  {% elseif code.expires_at and code.expires_at.lt(now) %}
                    <span class="badge badge-warning">{{ trans('StudentVerification::student-verification.admin_codes_expired') }}</span>
                  {% else %}
                    <span class="badge badge-success">{{ trans('StudentVerification::student-verification.admin_codes_available') }}</span>
                  {% endif %}
                </td>
                <td>{{ code.user ? code.user.nickname : '-' }}</td>
                <td>{{ code.used_at ? code.used_at.format('Y-m-d H:i') : '-' }}</td>
                <td>{{ code.expires_at ? code.expires_at.format('Y-m-d') : '-' }}</td>
                <td>
                  {% if not code.used_by and not code.revoked %}
                    <form method="post" action="{{ url('admin/student-verification/codes/' ~ code.id ~ '/revoke') }}">
                      <input type="hidden" name="_token" value="{{ csrf_token() }}">
                      <button type="submit" class="btn btn-sm btn-outline-danger"
                              onclick="return confirm('{{ trans('StudentVerification::student-verification.admin_codes_revoke_confirm') }}')">
                        {{ trans('StudentVerification::student-verification.admin_codes_revoke') }}
                      </button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="7" class="text-center text-muted py-4">
                  {{ trans('StudentVerification::student-verification.admin_codes_empty') }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        {{ codes.links()|raw }}
      </div>
    </div>
  </div>
</div>
{% endblock %}