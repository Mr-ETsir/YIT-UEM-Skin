{% extends 'user/base.twig' %}

{% block title %}{{ trans('StudentVerification::student-verification.page_title') }}{% endblock %}

{% block content %}
<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-graduation-cap"></i>
            {{ trans('StudentVerification::student-verification.page_title') }}
        </h3>
    </div>
    <div class="card-body">
        {% if verified %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                {{ trans('StudentVerification::student-verification.already_verified') }}
            </div>
            <table class="table table-bordered">
                <tr>
                    <td width="30%">{{ trans('StudentVerification::student-verification.school') }}</td>
                    <td>
                        {% if school == 'yit' %}
                            {{ trans('StudentVerification::student-verification.school_yit') }}
                        {% else %}
                            {{ trans('StudentVerification::student-verification.school_uem') }}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>{{ trans('StudentVerification::student-verification.student_id') }}</td>
                    <td>{{ studentId }}</td>
                </tr>
                <tr>
                    <td>{{ trans('StudentVerification::student-verification.student_name') }}</td>
                    <td>{{ studentName }}</td>
                </tr>
            </table>
        {% else %}
            <div class="callout callout-warning">
                <h5><i class="fas fa-exclamation-triangle"></i> {{ trans('StudentVerification::student-verification.verify_required_title') }}</h5>
                <p>{{ trans('StudentVerification::student-verification.verify_required_desc') }}</p>
            </div>

            <form id="verify-form">
                <div class="form-group">
                    <label for="school-select">{{ trans('StudentVerification::student-verification.select_school') }}</label>
                    <select class="form-control" id="school-select" name="school" required>
                        <option value="">{{ trans('StudentVerification::student-verification.select_school_placeholder') }}</option>
                        <option value="yit">{{ trans('StudentVerification::student-verification.school_yit') }}</option>
                        <option value="uem">{{ trans('StudentVerification::student-verification.school_uem') }}</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="student-id-input">{{ trans('StudentVerification::student-verification.student_id') }}</label>
                    <input type="text" class="form-control" id="student-id-input" name="student_id"
                           placeholder="{{ trans('StudentVerification::student-verification.student_id_placeholder') }}" required>
                </div>
                <div class="form-group">
                    <label for="password-input">{{ trans('StudentVerification::student-verification.password_label') }}</label>
                    <input type="password" class="form-control" id="password-input" name="password"
                           placeholder="{{ trans('StudentVerification::student-verification.password_placeholder') }}" required>
                    <small class="text-muted">
                        <i class="fas fa-shield-alt"></i>
                        {{ trans('StudentVerification::student-verification.password_notice') }}
                    </small>
                </div>
                <button type="submit" class="btn btn-primary" id="verify-btn">
                    <i class="fas fa-check"></i>
                    {{ trans('StudentVerification::student-verification.verify_btn') }}
                </button>
                <span id="verify-loading" style="display:none; margin-left: 10px;">
                    <i class="fas fa-spinner fa-spin"></i>
                    {{ trans('StudentVerification::student-verification.verifying') }}
                </span>
            </form>

            <div id="verify-result" style="margin-top: 16px;"></div>
        {% endif %}
    </div>
</div>

{% if not verified %}
<script>
document.getElementById('verify-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    var btn = document.getElementById('verify-btn');
    var loading = document.getElementById('verify-loading');
    var resultDiv = document.getElementById('verify-result');

    btn.disabled = true;
    loading.style.display = 'inline';
    resultDiv.innerHTML = '';

    var formData = {
        school: document.getElementById('school-select').value,
        student_id: document.getElementById('student-id-input').value,
        password: document.getElementById('password-input').value
    };

    try {
        var resp = await fetch('/student-verification/verify', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
                'Accept': 'application/json'
            },
            body: JSON.stringify(formData)
        });
        var data = await resp.json();

        if (data.success) {
            resultDiv.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle"></i> {{ trans("StudentVerification::student-verification.verify_success")|e("js") }}</div>';
            setTimeout(function() { location.reload(); }, 1500);
        } else {
            resultDiv.innerHTML = '<div class="alert alert-danger"><i class="fas fa-times-circle"></i> ' + data.message + '</div>';
        }
    } catch (error) {
        resultDiv.innerHTML = '<div class="alert alert-danger"><i class="fas fa-times-circle"></i> {{ trans("StudentVerification::student-verification.network_error")|e("js") }}</div>';
    } finally {
        btn.disabled = false;
        loading.style.display = 'none';
    }
});
</script>
{% endif %}
{% endblock %}
