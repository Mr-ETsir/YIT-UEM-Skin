{% extends 'user.base' %}

{% block title %}{{ trans('StudentVerification::student-verification.page_title') }}{% endblock %}

{% block content %}
<div class="row">
  <div class="col-md-7">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-graduation-cap mr-1"></i>
          {{ trans('StudentVerification::student-verification.page_title') }}
        </h3>
      </div>
      <div class="card-body">
        {% if verified %}
          <div class="alert alert-success">
            <i class="fas fa-check-circle mr-1"></i>
            {{ trans('StudentVerification::student-verification.already_verified') }}
          </div>
          <table class="table table-sm table-bordered">
            <tbody>
              <tr>
                <th class="bg-light" style="width: 120px">{{ trans('StudentVerification::student-verification.school') }}</th>
                <td>
                  {% if school == 'yit' %}
                    {{ trans('StudentVerification::student-verification.school_yit') }}
                  {% else %}
                    {{ trans('StudentVerification::student-verification.school_uem') }}
                  {% endif %}
                </td>
              </tr>
              <tr>
                <th class="bg-light">{{ trans('StudentVerification::student-verification.student_id') }}</th>
                <td>{{ studentId }}</td>
              </tr>
              <tr>
                <th class="bg-light">{{ trans('StudentVerification::student-verification.student_name') }}</th>
                <td>{{ studentName }}</td>
              </tr>
            </tbody>
          </table>
          <p class="text-muted mb-0 mt-2" style="font-size: .875rem">
            <i class="fas fa-shield-alt mr-1"></i>
            {{ trans('StudentVerification::student-verification.privacy_ok') }}
          </p>
        {% else %}
          <div class="callout callout-info">
            {{ trans('StudentVerification::student-verification.verify_required_desc')|nl2br }}
          </div>

          <form id="verify-form" autocomplete="off">
            <div class="form-group">
              <label for="school-select">
                {{ trans('StudentVerification::student-verification.select_school') }}
              </label>
              <select class="form-control" id="school-select" name="school" required>
                <option value="">
                  {{ trans('StudentVerification::student-verification.select_school_placeholder') }}
                </option>
                <option value="yit">{{ trans('StudentVerification::student-verification.school_yit') }}</option>
                <option value="uem">{{ trans('StudentVerification::student-verification.school_uem') }}</option>
              </select>
              <small class="form-text text-muted" id="school-hint"></small>
            </div>

            <div class="form-group">
              <label for="student-id-input">
                {{ trans('StudentVerification::student-verification.student_id') }}
              </label>
              <input type="text" class="form-control" id="student-id-input" name="student_id"
                     placeholder="{{ trans('StudentVerification::student-verification.student_id_placeholder') }}"
                     required autocomplete="off">
            </div>

            <div class="form-group">
              <label for="password-input">
                {{ trans('StudentVerification::student-verification.password_label') }}
              </label>
              <input type="password" class="form-control" id="password-input" name="password"
                     placeholder="{{ trans('StudentVerification::student-verification.password_placeholder') }}"
                     required autocomplete="off">
              <small class="form-text text-muted">
                <i class="fas fa-shield-alt mr-1"></i>
                {{ trans('StudentVerification::student-verification.password_notice') }}
              </small>
            </div>

            <button type="submit" class="btn btn-primary" id="verify-btn">
              <i class="fas fa-check mr-1"></i>
              {{ trans('StudentVerification::student-verification.verify_btn') }}
            </button>
          </form>

          <div id="verify-result" class="mt-3"></div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card card-outline card-secondary">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-info-circle mr-1"></i>
          {{ trans('StudentVerification::student-verification.help_title') }}
        </h3>
      </div>
      <div class="card-body" style="font-size: .9rem">
        <h6 class="font-weight-bold">{{ trans('StudentVerification::student-verification.school_yit') }}</h6>
        <p class="text-muted">{{ trans('StudentVerification::student-verification.help_yit') }}</p>
        <hr>
        <h6 class="font-weight-bold">{{ trans('StudentVerification::student-verification.school_uem') }}</h6>
        <p class="text-muted">{{ trans('StudentVerification::student-verification.help_uem') }}</p>
        <hr>
        <p class="text-muted mb-0">
          <i class="fas fa-lock mr-1"></i>
          {{ trans('StudentVerification::student-verification.help_privacy') }}
        </p>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block before_foot %}
<script>
(function () {
  var hints = {
    yit: '{{ trans("StudentVerification::student-verification.hint_yit") }}',
    uem: '{{ trans("StudentVerification::student-verification.hint_uem") }}'
  };

  var schoolSelect = document.getElementById('school-select');
  if (schoolSelect) {
    schoolSelect.addEventListener('change', function () {
      var hint = document.getElementById('school-hint');
      hint.textContent = hints[schoolSelect.value] || '';
    });

    var form = document.getElementById('verify-form');
    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var btn = document.getElementById('verify-btn');
      var result = document.getElementById('verify-result');
      result.innerHTML = '';
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-1"></span>' +
        '{{ trans("StudentVerification::student-verification.verifying") }}';

      var payload = {
        school: schoolSelect.value,
        student_id: document.getElementById('student-id-input').value,
        password: document.getElementById('password-input').value
      };

      fetch('{{ url("student-verification/verify") }}', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      })
        .then(function (resp) { return resp.json().catch(function () { return null; }); })
        .then(function (data) {
          if (data && data.success) {
            result.innerHTML = '<div class="alert alert-success mb-0"><i class="fas fa-check-circle mr-1"></i>' +
              (data.message || '{{ trans("StudentVerification::student-verification.verify_success") }}') + '</div>';
            setTimeout(function () { window.location.reload(); }, 1500);
          } else {
            var message = data && data.message
              ? data.message
              : '{{ trans("StudentVerification::student-verification.verify_failed") }}';
            result.innerHTML = '<div class="alert alert-danger mb-0"><i class="fas fa-times-circle mr-1"></i>' +
              message + '</div>';
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check mr-1"></i>{{ trans("StudentVerification::student-verification.verify_btn") }}';
          }
        })
        .catch(function () {
          result.innerHTML = '<div class="alert alert-danger mb-0"><i class="fas fa-times-circle mr-1"></i>' +
            '{{ trans("StudentVerification::student-verification.network_error") }}</div>';
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check mr-1"></i>{{ trans("StudentVerification::student-verification.verify_btn") }}';
        });
    });
  }
})();
</script>
{% endblock %}