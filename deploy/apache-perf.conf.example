# YIT & UEM 皮肤站 Apache 性能优化配置
# 用法：sudo cp deploy/apache-perf.conf.example /etc/apache2/conf-available/skin-perf.conf
#       sudo a2enmod http2 && sudo a2enconf skin-perf && sudo systemctl restart apache2

# gzip 压缩文本类资源（CSS 1.35MB -> ~155KB）
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml application/x-javascript text/xml image/svg+xml application/wasm
    DeflateCompressionLevel 6
</IfModule>

# 带哈希文件名的构建产物：一年缓存，不可变
<LocationMatch "^/app/.+\.(js|css|woff2?|ttf|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</LocationMatch>

# 图片（背景/logo）：短缓存，保证替换素材后能更新
<LocationMatch "^/app/.+\.(webp|png|jpe?g|gif)$">
    Header set Cache-Control "public, max-age=86400"
</LocationMatch>

# HTTP/2（需 a2enmod http2）
Protocols h2 http/1.1